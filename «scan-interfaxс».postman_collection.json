							"});\r",
							"\r",
							"pm.test(\"ключ accessToken,записать в auth_Token\", function () {\r",
							"        var jsonData = JSON.parse(responseBody);\r",
							"        pm.collectionVariables.set(\"auth_Token\", jsonData.accessToken);\r",
							"    });\r",
